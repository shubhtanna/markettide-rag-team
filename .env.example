# Copy this file to .env and put YOUR OWN key in it. Never commit .env.
# Only needed for the chatbot (not for the homepage). Any ONE key is enough;
# if several are set they are tried in this order, so the next one is a backup.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# optional: which OpenAI models to try, first that works wins
# OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini
